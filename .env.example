# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=campushub
POSTGRES_PASSWORD=campushub_dev_password
POSTGRES_DB=campushub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full override (optional). If unset it is assembled from the parts above.
# DATABASE_URL=postgresql+psycopg://campushub:campushub_dev_password@postgres:5432/campushub

# ─── Backend ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME=CampusHub

# CHANGE THIS IN ANY NON-LOCAL ENVIRONMENT (openssl rand -hex 32)
SECRET_KEY=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ─── File storage ──────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/app/uploads
LOCAL_STORAGE_PUBLIC_URL=/media
MAX_UPLOAD_SIZE_MB=15

# Only used when STORAGE_BACKEND=s3 (production / AWS)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
# Prefer IAM roles over static keys in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Seed ──────────────────────────────────────────────────────────────────
SEED_DEFAULT_PASSWORD=Campus@123

# ─── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Show the demo-account shortcuts on the sign-in page. Development builds
# always show them; a deployed build shows them only when this is true.
VITE_DEMO_MODE=true
