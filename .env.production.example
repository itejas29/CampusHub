# ═══════════════════════════════════════════════════════════════════════════
#  CampusHub — production configuration (AWS)
#
#  Copy to .env on the EC2 host, or set these as environment variables /
#  SSM parameters. NEVER commit a filled-in copy of this file.
#
#  Target architecture:
#    Frontend   S3 + CloudFront          (static build, no server)
#    Backend    EC2 behind an ALB        (uvicorn, systemd or Docker)
#    Database   RDS PostgreSQL           (private subnet, not public)
#    Documents  S3                       (private bucket, no public read)
#    Logs       CloudWatch
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────────────────
# Point at the RDS endpoint. The instance must NOT be publicly accessible;
# reach it from the backend's security group only.
POSTGRES_HOST=campushub-prod.abc123.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=campushub
POSTGRES_USER=campushub_app
POSTGRES_PASSWORD=            # from Secrets Manager / SSM, never literal here
# Or set the whole URL. sslmode=require is not optional against RDS.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/campushub?sslmode=require

# ─── Backend ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Must be false. Debug mode changes error output and can leak internals.
DEBUG=false
API_V1_PREFIX=/api/v1
PROJECT_NAME=CampusHub

# 32 bytes of real randomness: openssl rand -hex 32
# This key signs every access token AND every file download link, so rotating
# it invalidates both. Store it in Secrets Manager, not in the AMI.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Exact origins only — no wildcard. Credentials are sent with requests, and a
# wildcard with credentials is both invalid and dangerous.
BACKEND_CORS_ORIGINS=https://campushub.pdeu.ac.in

# ─── File storage ──────────────────────────────────────────────────────────
STORAGE_BACKEND=s3
AWS_REGION=ap-south-1
S3_BUCKET_NAME=campushub-prod-documents

# Leave S3_PUBLIC_BASE_URL EMPTY for the documents bucket.
#
# Setting it makes the backend hand out a CloudFront path instead of a
# presigned URL — which is right for public assets and wrong for student
# documents: it would make every certificate readable by URL alone, outside
# every authorisation check. Documents are served through
# GET /api/v1/files/{id}/download, which authorises the caller first.
S3_PUBLIC_BASE_URL=

# Prefer an EC2 instance role over static keys. Leave both blank when the
# instance profile grants s3:GetObject/PutObject on the bucket above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAX_UPLOAD_SIZE_MB=15

# ─── Seeding ───────────────────────────────────────────────────────────────
# The demo seeder must never run against production. Leave this unset; the
# seed command is not part of the production start-up path.
SEED_DEFAULT_PASSWORD=

# ─── Frontend build ────────────────────────────────────────────────────────
# Baked into the static bundle at build time, so it must be the public API URL.
VITE_API_BASE_URL=https://api.campushub.pdeu.ac.in/api/v1
