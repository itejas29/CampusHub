.env
.env.*
# Templates carry no secrets and must stay tracked. The negation has to cover
# every *.example, not just .env.example, or .env.production.example is lost.
!.env*.example

# Uploaded and seed-generated files are regenerated by `make seed`; they are
# demo artefacts, not source. The trailing-slash-free form matches the upload
# directory wherever it sits, including backend/uploads/.
uploads/
!uploads/.gitkeep

.DS_Store
.idea/
.vscode/
*.log
postgres-data/
