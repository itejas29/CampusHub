__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# No trailing slash: frontend/node_modules is a symlink, which "node_modules/" misses.
node_modules
dist/
build/
.vite/
*.local
# TypeScript incremental build state — machine-local, regenerated on build.
*.tsbuildinfo

.env
.env.*
# Templates carry no secrets and must stay tracked. The negation has to cover
# every *.example, not just .env.example, or .env.production.example is lost.
!.env*.example

# Uploaded and seed-generated files are regenerated by `make seed`; they are
# demo artefacts, not source. The trailing-slash-free form matches the upload
# directory wherever it sits, including backend/uploads/.
uploads/
!uploads/.gitkeep

.DS_Store
.idea/
.vscode/
*.log
postgres-data/

# Playwright output — regenerated on every run.
playwright-report/
test-results/

# Local working files — kept on disk, not part of the app. The root index.html
# was an old static sign-in mock-up that embedded the demo password; the real
# app is built from frontend/.
/index.html
/pdeu_campus.jpg
*.pptx
.vercel
